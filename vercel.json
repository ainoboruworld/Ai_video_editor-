{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "next build",
  "installCommand": "npm install",
  "functions": {
    "src/app/api/ai/**/*.ts": { "maxDuration": 60 },
    "src/app/api/captions/**/*.ts": { "maxDuration": 60 },
    "src/app/api/media/**/*.ts": { "maxDuration": 30 }
  }
}
