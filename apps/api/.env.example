# Port the API listens on
PORT=4001

# Prisma SQLite database location (relative to apps/api/prisma or absolute)
DATABASE_URL="file:../data/dev.db"

# Optional: Ollama base URL for AI-refined titles/hooks/assistant (e.g. http://localhost:11434)
# OLLAMA_URL=

# faster-whisper model used by scripts/transcribe.py (tiny|base|small|medium|large-v3)
WHISPER_MODEL=small
