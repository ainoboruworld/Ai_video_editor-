generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Project {
  id           String     @id @default(cuid())
  name         String
  thumbnailUrl String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  sequences    Sequence[]
  assets       Asset[]
}

model Sequence {
  id        String            @id @default(cuid())
  projectId String
  project   Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  doc       String // JSON Sequence document
  version   Int               @default(1)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  versions  SequenceVersion[]
}

model SequenceVersion {
  id         String   @id @default(cuid())
  sequenceId String
  sequence   Sequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  version    Int
  doc        String
  createdAt  DateTime @default(now())

  @@unique([sequenceId, version])
}

model Asset {
  id           String       @id @default(cuid())
  projectId    String
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  kind         String // video | audio | image
  name         String
  status       String       @default("processing") // processing | ready | error
  originalUrl  String
  proxyUrl     String?
  thumbnailUrl String?
  waveformUrl  String?
  duration     Float?
  width        Int?
  height       Int?
  fps          Float?
  sizeBytes    Int          @default(0)
  error        String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  transcript   Transcript?
  scenes       Scene[]
  suggestions  Suggestion[]
}

model Transcript {
  id        String   @id @default(cuid())
  assetId   String   @unique
  asset     Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  json      String // {segments:[...]}
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Scene {
  id           String  @id @default(cuid())
  assetId      String
  asset        Asset   @relation(fields: [assetId], references: [id], onDelete: Cascade)
  start        Float
  end          Float
  thumbnailUrl String?
  index        Int     @default(0)
}

model Suggestion {
  id          String   @id @default(cuid())
  assetId     String
  asset       Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  kind        String // clip | broll | chapter | hook
  start       Float
  end         Float
  title       String
  description String
  score       Float?
  payload     String // JSON
  createdAt   DateTime @default(now())
}

model Job {
  id        String   @id @default(cuid())
  type      String
  status    String   @default("queued") // queued | running | done | error | cancelled
  progress  Float    @default(0)
  step      String?
  error     String?
  result    String? // JSON
  refId     String? // e.g. assetId or sequenceId
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
