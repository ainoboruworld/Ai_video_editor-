# --- OS ---
.DS_Store
Thumbs.db

# --- Python ---
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/

# --- Node ---
node_modules/
npm-debug.log*
yarn-error.log*

# --- Remotion ---
.remotion/
out/
scripts/remotion/out/

# --- Whisper model cache (re-downloaded on demand) ---
.cache/whisper/

# --- Env / secrets ---
.env
.env.*
!.env.example
*.key

# --- Editor ---
.vscode/
.idea/

# --- Project working data (kept out of version control) ---
input/raw/*
!input/raw/.gitkeep
input/processed/*
!input/processed/.gitkeep
input/archive/*
!input/archive/.gitkeep

output/reels/*
!output/reels/.gitkeep
output/youtube/*
!output/youtube/.gitkeep
output/shorts/*
!output/shorts/.gitkeep
output/drafts/*
!output/drafts/.gitkeep

captions/srt/*
!captions/srt/.gitkeep
captions/json/*
!captions/json/.gitkeep
captions/styled/*
!captions/styled/.gitkeep

logs/*
!logs/.gitkeep
temp/*
!temp/.gitkeep

# Large binary assets are tracked intentionally (music, fonts, logos, intros/outros)
# unless you prefer Git LFS — add rules here if needed.
