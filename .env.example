# Copy this file to .env and fill in the values you need.
# .env is git-ignored — never commit real secrets.

# --- AI providers (used by prompts/ workflows for scripting, captioning, etc.) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Whisper transcription ---
# tiny | base | small | medium | large  (bigger = more accurate, slower, more RAM)
WHISPER_MODEL=base
# cpu | cuda
WHISPER_DEVICE=cpu

# --- Remotion ---
# Only needed in sandboxed/offline environments where Remotion can't download
# its own headless Chrome (network egress to remotion.media is blocked).
# Point this at a local Chromium/Chrome binary; leave unset otherwise.
BROWSER_EXECUTABLE=

# --- Project paths (override defaults from config/paths.json if needed) ---
AI_VIDEO_EDITOR_INPUT_DIR=input
AI_VIDEO_EDITOR_OUTPUT_DIR=output
