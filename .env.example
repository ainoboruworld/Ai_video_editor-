# ---------------------------------------------------------------------------
# Everything here is optional. With an empty environment the editor still runs:
# projects save to the local filesystem, uploads stay in the browser session,
# prompts produce a labelled structural draft, and export happens in-browser.
# Each key switches on a real capability — nothing here is decorative.
# ---------------------------------------------------------------------------

# --- Free stock media (B-roll) ---------------------------------------------
# Pexels is the primary source (videos + photos): https://www.pexels.com/api/
PEXELS_API_KEY=
# Pixabay is the fallback (videos + images): https://pixabay.com/api/docs/
PIXABAY_API_KEY=
# Unsplash provides stills only: https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=

# --- AI providers (free tiers first) ----------------------------------------
# Script, storyboard, B-roll queries, captions, titles and edit review.
# The first configured provider wins unless AI_PROVIDER forces one.
# Either free key below is enough — no paid account is required anywhere.

# Google AI Studio, free tier: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Groq, free tier: https://console.groq.com/keys
# Also powers automatic captions (Whisper) at no cost.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TRANSCRIBE_MODEL=whisper-large-v3-turbo

# Optional, paid — supported but never required.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TRANSCRIBE_MODEL=whisper-1

# gemini | groq | openai | offline
AI_PROVIDER=

# --- Database ---------------------------------------------------------------
# Postgres (Vercel Postgres, Neon, Supabase, RDS…). Without it, projects are
# stored on the filesystem — fine locally, but per-instance and short-lived on
# serverless hosts.
DATABASE_URL=

# --- Object storage (S3-compatible: S3, Cloudflare R2, Backblaze B2, MinIO) --
# Enables direct browser → bucket uploads, so large media never passes through
# a serverless function. Without it, uploads over 4 MB stay in the browser tab.
STORAGE_URL=
STORAGE_BUCKET=
STORAGE_REGION=auto
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
# Public read base (CDN or bucket URL). Optional: without it, files are served
# through /api/files.
STORAGE_PUBLIC_URL=

# --- Cloud rendering --------------------------------------------------------
# A Remotion render worker (scripts/render-worker.mjs) on any container host.
# Vercel cannot run this itself — see docs/RENDERING.md.
RENDER_WORKER_URL=
RENDER_WORKER_TOKEN=

# --- App --------------------------------------------------------------------
# Public origin, used to build the render worker's progress callback URL.
APP_URL=
